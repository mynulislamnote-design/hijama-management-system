datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Patient {
  id           String    @id @default(uuid())
  name         String
  phone        String
  problem      String
  serviceType  String
  feePaid      Float
  sessionDate  String
  nextFollowUp String?
  createdAt    DateTime  @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  type        String
  category    String
  amount      Float
  note        String?
  date        String
  createdAt   DateTime @default(now())
}

model ScheduledMessage {
  id        String   @id @default(uuid())
  category  String   // SIHR, JINN, AYN, HIJAMA, ALL
  timeSlot  String   // MORNING, EVENING
  dayNumber Int?     // ১ থেকে ৩০ দিন (অথবা নির্দিষ্ট তারিখের জন্য)
  date      String?  // যেমন: 2026-11-25 (যদি নির্দিষ্ট তারিখে পাঠাতে চান)
  message   String   @db.Text
  createdAt DateTime @default(now())
}