datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Patient {
  id              String    @id @default(uuid())
  name            String
  phone           String
  problem         String?
  serviceType     String
  feePaid         Float
  sessionDate     String
  nextFollowUp    String?
  raqiName        String?
  problemCategory String?   @default("JINN")
  createdAt       DateTime  @default(now())
}

model Transaction {
  id        String   @id @default(uuid())
  type      String
  category  String
  amount    Float
  note      String?
  date      String
  createdAt DateTime @default(now())
}

model Raqi {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  createdAt DateTime @default(now())
}

model ScheduledMessage {
  id        String   @id @default(uuid())
  category  String   @default("ALL")
  timeSlot  String   @default("MORNING")
  dayNumber Int?
  date      String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}